{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "ModelContextProtocol": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "ModelContextProtocol": "Debug"
    }
  },
  "AraianLab": {
    "BaseUrl": "${ARIANALAB_BASE_URL?https://klims.labor-kneissler.de/}",
    "Jwt": {
      "SigningKey": "${ARIANALAB_JWT_SIGNING_KEY?}",
      "EncryptionKey": "${ARIANALAB_JWT_ENCRYPTION_KEY?}",
      "LifetimeHours": 17520,
      "Issuer": "ariana-mcp",
      "Audience": "ariana-mcp"
    }
  },
  "Okf": {
    "BundlePath": "Okf/klims"
  }
}
